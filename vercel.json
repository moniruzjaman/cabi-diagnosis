{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/market-prices",
      "destination": "/api/crop-prices?mode=market"
    },
    {
      "source": "/api/metrics",
      "destination": "/api/health?endpoint=metrics"
    },
    {
      "source": "/api/signing-token",
      "destination": "/api/health?endpoint=signing-token"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/community?resource=feedback"
    },
    {
      "source": "/api/outbreaks",
      "destination": "/api/community?resource=outbreaks"
    },
    {
      "source": "/api/presence",
      "destination": "/api/community?resource=presence"
    },
    {
      "source": "/api/diagnoses",
      "destination": "/api/community?resource=diagnoses"
    },
    {
      "source": "/api/analytics",
      "destination": "/api/community?resource=analytics"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
