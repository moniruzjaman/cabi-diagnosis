# ─────────────────────────────────────────────────────────────
# উদ্ভিদ গোয়েন্দা (Plant Detective) — Environment Variables
# ─────────────────────────────────────────────────────────────
# Set these in Vercel Dashboard → Settings → Environment Variables.
# NEVER commit .env files to version control.
#
# NOTE: No VITE_ prefixed vars are needed. All sensitive operations
# are handled server-side via API routes. The frontend never sees
# any API keys or database credentials.

# ═══ AI Provider Keys (at least one required for diagnosis) ═══

# Google Gemini API Key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API Key — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API Key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ═══ Free-tier AI safety policy ═══
# Conservative caps prevent accidental provider overuse. Values are server-side only.
AI_MAX_ATTEMPTS=5
AI_MAX_REQUESTS_PER_DAY=250
AI_MAX_VISION_REQUESTS_PER_DAY=100
AI_MAX_OUTPUT_TOKENS=2200
AI_MAX_IMAGE_BYTES=6000000
AI_REQUEST_TIMEOUT_MS=25000
# ═══ Turso Database (recommended — enables persistent analytics) ═══

# Turso database URL — https://turso.tech (free: 9GB, 1B reads/month)
# Create a database: turso db create cabi-diagnosis
# Get the URL:      turso db show cabi-diagnosis --url
TURSO_DATABASE_URL=

# Turso auth token — https://turso.tech/app
# Create a token:  turso db tokens create cabi-diagnosis
TURSO_AUTH_TOKEN=

# ═══ Security (auto-configured — no manual setup needed) ═══

# Request signing: AUTO-DERIVED from Turso credentials.
# Admin access: AUTO-DERIVED from Turso credentials.
# No separate secrets required.

# ═══ CORS Configuration (optional) ═══

# Comma-separated list of allowed origins for API CORS.
# Only used in production (VERCEL env set).
# Defaults to https://cabi-diagnosis.vercel.app if not set.
# *.vercel.app domains are automatically allowed.
# ALLOWED_ORIGINS=https://cabi-diagnosis.vercel.app,https://your-custom-domain.com

# ═══ Vercel (auto-set by Vercel deployment) ═══
# VERCEL=1

# ═══ Google Sign-In (user authentication) ═══

# Google OAuth Client ID — https://console.cloud.google.com/apis/credentials
# Create: Credentials → Create Credentials → OAuth client ID → Web application
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://cabi-diagnosis.vercel.app
#   https://cabi.krishiai.live
GOOGLE_CLIENT_ID=

# Session signing secret — 32+ random hex chars
# Generate with: openssl rand -hex 32
# Used to sign httpOnly session cookies (HMAC-SHA256 JWTs)
SESSION_SECRET=

# ═══ Frontend (Vite-exposed — safe to expose, NOT secret) ═══

# Same Google OAuth Client ID, but VITE_-prefixed so Vite exposes it to the browser.
# The browser needs it to initialize Google Identity Services.
# This is safe to expose — Google's OAuth flow verifies origin server-side.
VITE_GOOGLE_CLIENT_ID=
